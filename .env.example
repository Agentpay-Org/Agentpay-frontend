# AgentPay Frontend Environment Variables Reference
# Copy this file to .env.local to configure your local development environment.
# Note: All NEXT_PUBLIC_* variables are embedded into the client bundle at build time.
# Never place secret API keys or private credentials in NEXT_PUBLIC_* variables.

# NEXT_PUBLIC_AGENTPAY_API_BASE
# Base URL for the AgentPay backend API service. Consumed by resolveApiBase() and next.config.ts.
# Default: http://localhost:3001
# Origin Constraints (enforced by resolveApiBase):
#   - Must be a valid absolute URL (e.g. http://localhost:3001 or https://api.example.com).
#   - Trailing slashes are automatically trimmed.
#   - In production builds (NODE_ENV=production), HTTP origins are rejected unless host is localhost, 127.0.0.1, or ::1.
#   - In development mode, HTTP on non-localhost hosts logs a console warning.
#   - Non-HTTP/HTTPS protocols (e.g. ftp://) or malformed URLs will throw a runtime error.
NEXT_PUBLIC_AGENTPAY_API_BASE=http://localhost:3001

# NEXT_PUBLIC_AGENTPAY_SITE_ORIGIN
# Canonical frontend web site origin used by src/app/sitemap.ts, src/app/robots.ts, and SEO metadata.
# Default: http://localhost:3000
# Origin Constraints (enforced by resolveSiteOrigin):
#   - Must be a valid origin URL (e.g. https://dashboard.example.com).
#   - Trailing slashes are automatically trimmed.
NEXT_PUBLIC_AGENTPAY_SITE_ORIGIN=http://localhost:3000
